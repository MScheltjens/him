# Resend (https://resend.com) — used by lib/actions.ts to send the contact form
RESEND_API_KEY=
# Optional: sender address. Requires a verified domain in Resend once you have one.
# Falls back to onboarding@resend.dev (Resend's shared test sender) if unset.
RESEND_FROM_EMAIL=

# Where the contact form actually delivers to during local testing (overrides site.email in data/site.ts)
CONTACT_TO_EMAIL=
